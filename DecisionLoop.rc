#include <windows.h>
#include <commctrl.h>
#include "Resource.h"

#define IDC_STATIC -1

// Application Icons
IDI_DECISIONLOOP      ICON        "DecisionLoop.ico"
IDI_SMALL             ICON        "small.ico"

// Module Icons
IDI_BRAIN             ICON        "brain.ico"
IDI_HEART             ICON        "heart.ico"
IDI_BOLT              ICON        "bolt.ico"
IDI_SCALES            ICON        "scales.ico"
IDI_ECO               ICON        "eco.ico"
IDI_LOOP              ICON        "loop.ico"
IDI_FAST              ICON        "fast.ico"
IDI_TRIAGE            ICON        "triage.ico"
IDI_GROUP             ICON        "group.ico"

LANGUAGE LANG_ENGLISH, SUBLANG_ENGLISH_US

IDD_MAIN_DIALOG DIALOGEX 0, 0, 800, 600
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU
CAPTION "Decision Loop Dashboard"
FONT 10, "Segoe UI"
BEGIN
// Header with modern layout
ICON            IDI_DECISIONLOOP, IDC_STATIC, 20, 20, 32, 32
LTEXT           "Decision Loop", IDC_STATIC_TITLE, 60, 20, 200, 32, SS_LEFT
PUSHBUTTON      "Profile", IDC_BUTTON_PROFILE, 680, 20, 80, 32, BS_FLAT

// Main navigation cards (with icons and better spacing)
PUSHBUTTON      "Mind & Emotions", IDC_BUTTON_COGNITIVE, 20, 80, 180, 60, BS_FLAT | BS_ICON | BS_LEFT
PUSHBUTTON      "Values & Ethics", IDC_BUTTON_VALUE, 220, 80, 180, 60, BS_FLAT | BS_ICON | BS_LEFT
PUSHBUTTON      "Context & Bias", IDC_BUTTON_SYSTEMS, 420, 80, 180, 60, BS_FLAT | BS_ICON | BS_LEFT
PUSHBUTTON      "Action & Growth", IDC_BUTTON_IMPLEMENTATION, 620, 80, 160, 60, BS_FLAT | BS_ICON | BS_LEFT

// Main content area
GROUPBOX        "Modules", IDC_STATIC, 20, 160, 560, 320, WS_GROUP

// Module buttons with progress indicators
PUSHBUTTON      "Is my mind clear?", IDC_BUTTON_COGNITIVE_READINESS, 40, 190, 440, 40, BS_FLAT
CONTROL         "", IDC_STATIC_COGNITIVE_SCORE, "msctls_progress32", PBS_SMOOTH, 500, 200, 60, 20

PUSHBUTTON      "What am I feeling?", IDC_BUTTON_EMOTIONAL_CALIB, 40, 240, 440, 40, BS_FLAT
CONTROL         "", IDC_STATIC_EMOTIONAL_SCORE, "msctls_progress32", PBS_SMOOTH, 500, 250, 60, 20

PUSHBUTTON      "Do actions match goals?", IDC_BUTTON_IMPULSE_ALIGN, 40, 290, 440, 40, BS_FLAT
CONTROL         "", IDC_STATIC_IMPULSE_SCORE, "msctls_progress32", PBS_SMOOTH, 500, 300, 60, 20

PUSHBUTTON      "What matters most?", IDC_BUTTON_CORE_VALUES, 40, 340, 440, 40, BS_FLAT
CONTROL         "", IDC_STATIC_VALUES_SCORE, "msctls_progress32", PBS_SMOOTH, 500, 350, 60, 20

PUSHBUTTON      "Social Impact?", IDC_BUTTON_SOCIAL_ECO, 40, 390, 440, 40, BS_FLAT
CONTROL         "", IDC_STATIC_SOCIAL_SCORE, "msctls_progress32", PBS_SMOOTH, 500, 400, 60, 20

// Sidebar with specialized modes
GROUPBOX        "Specialized Modes", IDC_STATIC_SIDEBAR, 600, 160, 180, 320
PUSHBUTTON      "Fast-Loop", IDC_BUTTON_FAST_LOOP, 620, 190, 140, 50, BS_FLAT | BS_ICON
PUSHBUTTON      "Triage Mode", IDC_BUTTON_TRIAGE_MODE, 620, 250, 140, 50, BS_FLAT | BS_ICON
PUSHBUTTON      "Group Mode", IDC_BUTTON_GROUP_MODE, 620, 310, 140, 50, BS_FLAT | BS_ICON

// Bottom report area
GROUPBOX        "Report", IDC_STATIC, 20, 500, 760, 80
EDITTEXT        IDC_EDIT_REPORT, 30, 520, 740, 50, ES_MULTILINE | ES_READONLY | WS_VSCROLL
END
