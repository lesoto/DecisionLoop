#include <windows.h>
#include "Resource.h"

IDI_DECISIONLOOP ICON "DecisionLoop.ico"
IDI_SMALL ICON "small.ico"

IDD_MAIN_DIALOG DIALOGEX 0, 0, 320, 200
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU
CAPTION "Decision Loop"
FONT 8, "MS Shell Dlg"
BEGIN
DEFPUSHBUTTON   "Run", IDC_BUTTON_RUN, 209, 179, 50, 14
PUSHBUTTON      "Cancel", IDCANCEL, 260, 179, 50, 14
LTEXT           "Select Decision Mode:", IDC_STATIC, 7, 7, 80, 8
COMBOBOX        IDC_COMBO_MODE, 7, 18, 150, 100, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
EDITTEXT        IDC_EDIT_REPORT, 7, 40, 306, 132, ES_MULTILINE | ES_READONLY | WS_VSCROLL
END

IDD_INPUT_DIALOG DIALOGEX 0, 0, 300, 120
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU
CAPTION "Input"
FONT 8, "MS Shell Dlg"
BEGIN
    DEFPUSHBUTTON   "OK",IDOK,189,99,50,14
    PUSHBUTTON      "Cancel",IDCANCEL,240,99,50,14
    LTEXT           "",IDC_EDIT_PROMPT,7,7,286,20
    LTEXT           "",IDC_STATIC_INSTRUCTION,7,30,286,8
    EDITTEXT        IDC_EDIT_INPUT,7,40,286,20,ES_AUTOHSCROLL
END

IDD_LIST_DIALOG DIALOGEX 0, 0, 300, 200
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU
CAPTION "Select Option"
FONT 8, "MS Shell Dlg"
BEGIN
    DEFPUSHBUTTON   "OK",IDOK,189,179,50,14
    PUSHBUTTON      "Cancel",IDCANCEL,240,179,50,14
    LTEXT           "",IDC_EDIT_PROMPT,7,7,286,20
    LISTBOX         IDC_LIST_OPTIONS,7,30,286,140,LBS_NOINTEGRALHEIGHT | WS_VSCROLL | WS_TABSTOP
END