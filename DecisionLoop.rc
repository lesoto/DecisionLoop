#include <windows.h>
#include <commctrl.h>
#include "Resource.h"

#define IDC_STATIC -1

// Application Icons
IDI_DECISIONLOOP      ICON        "DecisionLoop.ico"
IDI_SMALL             ICON        "small.ico"

// Module Icons
IDI_BRAIN             ICON        "brain.ico"
IDI_HEART             ICON        "heart.ico"
IDI_BOLT              ICON        "bolt.ico"
IDI_SCALES            ICON        "scales.ico"
IDI_ECO               ICON        "eco.ico"
IDI_LOOP              ICON        "loop.ico"
IDI_FAST              ICON        "fast.ico"
IDI_TRIAGE            ICON        "triage.ico"
IDI_GROUP             ICON        "group.ico"

LANGUAGE LANG_ENGLISH, SUBLANG_ENGLISH_US

IDR_MAINFRAME MENU
BEGIN
POPUP "&File"
BEGIN
MENUITEM "&New", ID_FILE_NEW
MENUITEM "&Open...", ID_FILE_OPEN
MENUITEM "&Save", ID_FILE_SAVE
MENUITEM SEPARATOR
MENUITEM "E&xit", ID_FILE_EXIT
END
POPUP "&View"
BEGIN
MENUITEM "&Cognitive Layer", ID_VIEW_COGNITIVE
MENUITEM "&Value Layer", ID_VIEW_VALUE
MENUITEM "&Systems Layer", ID_VIEW_SYSTEMS
MENUITEM "&Implementation Layer", ID_VIEW_IMPLEMENT
END
POPUP "&Mode"
BEGIN
MENUITEM "&Fast Loop", ID_MODE_FAST
MENUITEM "&Triage Mode", ID_MODE_TRIAGE
END
END

IDD_MAIN_DIALOG DIALOGEX 0, 0, 640, 480
STYLE WS_OVERLAPPEDWINDOW | WS_VISIBLE
CAPTION "Decision Loop"
MENU IDR_MAINFRAME
FONT 10, "Segoe UI"
BEGIN
CONTROL         "", IDC_STATIC, "Static", SS_ETCHEDFRAME, 0, 0, 640, 30

ICON            IDI_DECISIONLOOP, IDC_STATIC, 20, 40, 32, 32
LTEXT           "Decision Loop", IDC_STATIC_TITLE, 60, 40, 200, 32, SS_LEFT
PUSHBUTTON      "Profile", IDC_BUTTON_PROFILE, 540, 40, 80, 32, BS_FLAT

PUSHBUTTON      "Mind & Emotions", IDC_BUTTON_COGNITIVE, 20, 90, 140, 40, BS_FLAT | BS_ICON | BS_LEFT
PUSHBUTTON      "Values & Ethics", IDC_BUTTON_VALUE, 170, 90, 140, 40, BS_FLAT | BS_ICON | BS_LEFT
PUSHBUTTON      "Context & Bias", IDC_BUTTON_SYSTEMS, 320, 90, 140, 40, BS_FLAT | BS_ICON | BS_LEFT
PUSHBUTTON      "Action & Growth", IDC_BUTTON_IMPLEMENTATION, 470, 90, 140, 40, BS_FLAT | BS_ICON | BS_LEFT

GROUPBOX        "Modules", IDC_STATIC, 20, 140, 440, 280

PUSHBUTTON      "Is my mind clear?", IDC_BUTTON_COGNITIVE_READINESS, 30, 160, 340, 30, BS_FLAT
CONTROL         "", IDC_STATIC_COGNITIVE_SCORE, "msctls_progress32", PBS_SMOOTH, 380, 165, 70, 20

PUSHBUTTON      "What am I feeling?", IDC_BUTTON_EMOTIONAL_CALIB, 30, 200, 340, 30, BS_FLAT
CONTROL         "", IDC_STATIC_EMOTIONAL_SCORE, "msctls_progress32", PBS_SMOOTH, 380, 205, 70, 20

GROUPBOX        "Specialized Modes", IDC_STATIC_SIDEBAR, 480, 140, 140, 280
PUSHBUTTON      "Fast-Loop", IDC_BUTTON_FAST_LOOP, 490, 160, 120, 30, BS_FLAT
PUSHBUTTON      "Triage Mode", IDC_BUTTON_TRIAGE_MODE, 490, 200, 120, 30, BS_FLAT
PUSHBUTTON      "Group Mode", IDC_BUTTON_GROUP_MODE, 490, 240, 120, 30, BS_FLAT

GROUPBOX        "Report", IDC_STATIC, 20, 430, 600, 40
EDITTEXT        IDC_EDIT_REPORT, 30, 445, 580, 20, ES_MULTILINE | ES_READONLY | WS_VSCROLL
END