#include <windows.h>
#include "Resource.h"

IDI_DECISIONLOOP ICON "DecisionLoop.ico"
IDI_SMALL ICON "small.ico"

IDD_LIST_DIALOG DIALOGEX 0, 0, 300, 200
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU
CAPTION "Select Option"
FONT 8, "MS Shell Dlg"
BEGIN
    DEFPUSHBUTTON   "OK",IDOK,189,179,50,14
    PUSHBUTTON      "Cancel",IDCANCEL,240,179,50,14
    LTEXT           "",IDC_EDIT_PROMPT,7,7,286,20
    LISTBOX         IDC_LIST_OPTIONS,7,30,286,140,LBS_NOINTEGRALHEIGHT | WS_VSCROLL | WS_TABSTOP
END

IDD_MAIN_DIALOG DIALOGEX 0, 0, 600, 400
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU
CAPTION "Decision Loop Dashboard"
FONT 8, "MS Shell Dlg"
BEGIN
    // Top Bar
    LTEXT           "Decision Loop",IDC_STATIC_TITLE,10,10,100,20
    PUSHBUTTON      "Profile",IDC_BUTTON_PROFILE,500,10,80,20

    // Central Hub: Layer Buttons
    PUSHBUTTON      "Mind & Emotions",IDC_BUTTON_COGNITIVE,10,50,130,50,BS_FLAT
    PUSHBUTTON      "Values & Ethics",IDC_BUTTON_VALUE,150,50,130,50,BS_FLAT
    PUSHBUTTON      "Context & Bias",IDC_BUTTON_SYSTEMS,290,50,130,50,BS_FLAT
    PUSHBUTTON      "Action & Growth",IDC_BUTTON_IMPLEMENTATION,430,50,130,50,BS_FLAT

    // Collapsible Module Panels (Initially Hidden)
    // Cognitive-Emotional Modules
    GROUPBOX        "Cognitive-Emotional Modules",IDC_STATIC,10,110,270,100,WS_GROUP,WS_EX_TRANSPARENT
    PUSHBUTTON      "🧠 Is my mind clear?",IDC_BUTTON_COGNITIVE_READINESS,20,130,240,30,BS_FLAT
    CONTROL         "",IDC_STATIC_COGNITIVE_SCORE,"msctls_progress32",PBS_SMOOTH,260,135,50,10
    PUSHBUTTON      "❤️ What am I feeling?",IDC_BUTTON_EMOTIONAL_CALIB,20,165,240,30,BS_FLAT
    CONTROL         "",IDC_STATIC_EMOTIONAL_SCORE,"msctls_progress32",PBS_SMOOTH,260,170,50,10
    PUSHBUTTON      "⚡ Do actions match goals?",IDC_BUTTON_IMPULSE_ALIGN,20,200,240,30,BS_FLAT
    CONTROL         "",IDC_STATIC_IMPULSE_SCORE,"msctls_progress32",PBS_SMOOTH,260,205,50,10

    // Value-Ethical Modules (Hidden)
    GROUPBOX        "Value-Ethical Modules",IDC_STATIC,10,110,270,100,WS_GROUP,WS_EX_TRANSPARENT
    PUSHBUTTON      "💎 What matters most?",IDC_BUTTON_CORE_VALUES,20,130,240,30,BS_FLAT
    CONTROL         "",IDC_STATIC_VALUES_SCORE,"msctls_progress32",PBS_SMOOTH,260,135,50,10
    PUSHBUTTON      "⚖️ Which option is ethical?",IDC_BUTTON_ETHICAL_COHERENCE,20,165,240,30,BS_FLAT
    CONTROL         "",IDC_STATIC_ETHICAL_SCORE,"msctls_progress32",PBS_SMOOTH,260,170,50,10
    PUSHBUTTON      "⏳ Short vs. long-term?",IDC_BUTTON_TIME_HORIZONS,20,200,240,30,BS_FLAT
    CONTROL         "",IDC_STATIC_HORIZONS_SCORE,"msctls_progress32",PBS_SMOOTH,260,205,50,10

    // Systems/Context Modules (Hidden)
    GROUPBOX        "Systems/Context Modules",IDC_STATIC,10,110,270,130,WS_GROUP,WS_EX_TRANSPARENT
    PUSHBUTTON      "🔍 What am I missing?",IDC_BUTTON_BIAS_TESTING,20,130,240,30,BS_FLAT
    CONTROL         "",IDC_STATIC_BIAS_SCORE,"msctls_progress32",PBS_SMOOTH,260,135,50,10
    PUSHBUTTON      "🌐 How complex is this?",IDC_BUTTON_UNCERTAINTY_MGMT,20,165,240,30,BS_FLAT
    CONTROL         "",IDC_STATIC_UNCERTAINTY_SCORE,"msctls_progress32",PBS_SMOOTH,260,170,50,10
    PUSHBUTTON      "👥 What do my ‘parts’ say?",IDC_BUTTON_INTERNAL_DIALOGUE,20,200,240,30,BS_FLAT
    CONTROL         "",IDC_STATIC_DIALOGUE_SCORE,"msctls_progress32",PBS_SMOOTH,260,205,50,10
    PUSHBUTTON      "🌍 Social/Eco Impact?",IDC_BUTTON_SOCIAL_ECO,20,235,240,30,BS_FLAT
    CONTROL         "",IDC_STATIC_SOCIAL_SCORE,"msctls_progress32",PBS_SMOOTH,260,240,50,10

    // Implementation/Learning Modules (Hidden)
    GROUPBOX        "Implementation/Learning Modules",IDC_STATIC,10,110,270,60,WS_GROUP,WS_EX_TRANSPARENT
    PUSHBUTTON      "🔄 What did I learn?",IDC_BUTTON_FEEDBACK_LOOPS,20,130,240,30,BS_FLAT
    CONTROL         "",IDC_STATIC_FEEDBACK_SCORE,"msctls_progress32",PBS_SMOOTH,260,135,50,10

    // Right Sidebar: Specialized Modes
    PUSHBUTTON      "🏃 Fast-Loop",IDC_BUTTON_FAST_LOOP,480,110,100,30,BS_FLAT
    PUSHBUTTON      "🚨 Triage Mode",IDC_BUTTON_TRIAGE_MODE,480,150,100,30,BS_FLAT
    PUSHBUTTON      "👥 Group Mode",IDC_BUTTON_GROUP_MODE,480,190,100,30,BS_FLAT

    // Report Display
    EDITTEXT        IDC_EDIT_REPORT,10,250,560,140,ES_MULTILINE | ES_READONLY | WS_VSCROLL
END